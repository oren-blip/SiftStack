# ── Data Source Credentials ─────────────────────────────────────────
# Required for web scraping (tnpublicnotice.com or your state's notice site)
TNPN_EMAIL=your_email@example.com
TNPN_PASSWORD=your_password_here

# 2Captcha API key for reCAPTCHA v2 solving (~$2.99/1000 solves)
# Sign up at https://2captcha.com
CAPTCHA_API_KEY=your_2captcha_api_key_here

# ── CRM Integration ────────────────────────────────────────────────
# DataSift.ai (formerly REISift) — automated upload + enrich + skip trace
DATASIFT_EMAIL=your_datasift_email@example.com
DATASIFT_PASSWORD=your_datasift_password_here

# ── Enrichment API Keys ────────────────────────────────────────────
# Smarty (address standardization, USPS validation, geocoding)
# Sign up at https://smarty.com — free tier: 250 lookups/month
SMARTY_AUTH_ID=your_smarty_auth_id
SMARTY_AUTH_TOKEN=your_smarty_auth_token

# OpenWeb Ninja (Zillow property data — Zestimate, MLS, equity)
# Sign up at https://openwebninja.com — free tier: 100 requests/month
OPENWEBNINJA_API_KEY=your_openwebninja_api_key

# Anthropic (Claude Haiku — LLM parsing, obituary search, entity research)
# Sign up at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# Serper.dev (Google Search — DM address lookup)
# Sign up at https://serper.dev — free tier: 2,500 queries
SERPER_API_KEY=your_serper_api_key

# Firecrawl (JS-rendered page scraping — DM address extraction)
# Sign up at https://firecrawl.dev — free tier: 500 pages
FIRECRAWL_API_KEY=fc-your-key-here

# ── Skip Trace & Phone Validation ──────────────────────────────────
# Tracerfy (batch skip trace — phones, emails, mailing addresses)
# $0.02/record — sign up at https://tracerfy.com
TRACERFY_API_KEY=your_tracerfy_api_key

# Trestle (phone scoring — 5-tier dial priority)
# $0.015/phone — sign up at https://trestleiq.com
TRESTLE_API_KEY=your_trestle_api_key

# Enformion / Endato PersonSearch (phone fallback for named PRs that
# Tracerfy can't crack — nc_deep_prospect.py Phase 2). ~$0.35 per MATCH,
# misses free. Credentials are the API ACCESS PROFILE from the Enformion
# Console (Console -> API), NOT your website login. Leave unset to keep
# the fallback inert; off-switch NC_ENFORMION=0.
ENFORMION_AP_NAME=your_enformion_access_profile_name
ENFORMION_AP_PASSWORD=your_enformion_access_profile_password

# ── Notifications ──────────────────────────────────────────────────
# Slack or Discord webhook for daily run summaries + error alerts
# Discord: use /slack suffix: https://discord.com/api/webhooks/{id}/{token}/slack
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# ── Dropbox Auto-Polling (courthouse photo import) ─────────────────
# Create a Dropbox app at https://www.dropbox.com/developers/apps
DROPBOX_APP_KEY=your_app_key
DROPBOX_APP_SECRET=your_app_secret
DROPBOX_REFRESH_TOKEN=your_refresh_token
DROPBOX_POLL_INTERVAL=900
DROPBOX_ROOT_FOLDER=TN Public Notice

# ── LLM routing ─────────────────────────────────────────────────────
# Routing is PER JOB and decided by the MODEL ID, not by a global switch:
#   "vendor/model"  (google/gemini-2.5-flash)  -> OpenRouter   [cheap jobs]
#   bare id         (claude-sonnet-4-6)        -> Anthropic    [accuracy jobs]
# So the high-volume throwaway reads sit on a cheap model while the
# accuracy-critical ones stay on Claude, and nothing can move them all by
# accident. Requires OPENROUTER_API_KEY below for any "vendor/model" id.
#
# LLM_BACKEND is a global OVERRIDE — leave it at "anthropic". It is the only
# way to reach ollama, and setting it to "openrouter" forces EVERYTHING there,
# which also disables the handwriting/vision path that reads NC court forms.
LLM_BACKEND=anthropic

# --- cheap jobs (OpenRouter) ---
# Heir verification: "is this survivor alive?" — a yes/no + date-of-death read
# that ran ~417 times a night and was ~$1.75 of a $2.58 nightly bill on Haiku.
# A/B'd against Haiku on real obituary pages 2026-09-09: identical alive/dead
# and DOD on every case. Set to claude-haiku-4-5-20251001 to revert.
# HEIR_VERIFY_LLM_MODEL=google/gemini-2.5-flash
# ZILLOW_LLM_MODEL=google/gemini-2.5-flash     # page status/home-type classify
# SUMMARY_LLM_MODEL=google/gemini-2.5-flash    # 2-3 sentence lead blurb
# OPENROUTER_API_KEY=sk-or-v1-your-key-here
# OPENROUTER_MODEL=google/gemini-2.5-flash     # fallback when a call names none
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- accuracy jobs (Anthropic) — think hard before moving these ---
# LLM_MODEL=claude-haiku-4-5-20251001          # court PDF/will extraction, notice parsing
# Obituary identity + heir/survivor extraction. Deliberately a STRONGER model:
# a wrong heir map sends the whole deal down the wrong path, and this was moved
# up to Sonnet to fix a real hallucination bug (commit 83cfb97). Leave it.
# OBITUARY_LLM_MODEL=claude-sonnet-4-6
# LLM_VISION_MODEL=claude-sonnet-5             # handwriting on court forms; Anthropic-only

# --- local (free, dev only) ---
# OLLAMA_MODEL=qwen2.5:7b
# OLLAMA_BASE_URL=http://localhost:11434/v1/

# ── Google Drive (optional — CSV backup) ────────────────────────────
# GOOGLE_DRIVE_FOLDER_ID=your_folder_id
# GOOGLE_SERVICE_ACCOUNT_KEY=base64_encoded_json_key

# ── Ancestry.com (optional — SSDI + obituary collection) ───────────
# Requires World Explorer subscription ($29/month)
# ANCESTRY_EMAIL=your_email@example.com
# ANCESTRY_PASSWORD=your_password

# ── Daily Report Email ─────────────────────────────────────────────
# Used by scripts/daily_report.py to email the daily summary after the
# 6 PM pipeline finishes. TWO options — pick one:
#
# Option A: Resend (recommended, works with any Google Workspace setup)
#   1. Sign up at https://resend.com (free 3,000 emails/month)
#   2. Verify your domain (DNS records)
#   3. Generate an API key under Sending access
# RESEND_API_KEY=re_your_key_here
# REPORT_FROM=reports@yourdomain.com      # any sender on your verified domain
# REPORT_TO=you@yourdomain.com,team@yourdomain.com
#
# Option B: Gmail/Workspace SMTP (only works if your Workspace admin
# allows app passwords — many Workspace plans no longer do)
#   1. Enable 2-Step Verification
#   2. Generate an app password at https://myaccount.google.com/apppasswords
# SMTP_USER=your_email@example.com
# SMTP_PASS=your_16_digit_app_password
# REPORT_TO=your_email@example.com
# SMTP_HOST=smtp.gmail.com   # default
# SMTP_PORT=587               # default (TLS)
